{
  "name": "dsh-codegraph",
  "version": "1.0.0",
  "description": "CodeGraph for DSH — registers 13 native `codegraph_*` tools (status/init/index/sync/uninit/query/node/explore/files/callers/callees/impact/affected) wrapping the `codegraph` CLI, so the DSH agent can bootstrap, maintain, and query a pre-indexed code knowledge graph without grepping files.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codegraph",
    "code-graph",
    "code-search",
    "code-index",
    "tools",
    "deepseek",
    "harness"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangzhenguo/dsh-codegraph.git"
  },
  "homepage": "https://github.com/jiangzhenguo/dsh-codegraph",
  "bugs": {
    "url": "https://github.com/jiangzhenguo/dsh-codegraph/issues"
  }
}
